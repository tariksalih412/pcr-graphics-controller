<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PcrGraphics.Core\PcrGraphics.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Version>1.0.0</Version>
    <Product>PCR Graphics Controller</Product>
    <Description>On-air graphics control panel for CasparCG (AMCP)</Description>
  </PropertyGroup>

  <!-- Release build: one self-contained exe for win-x64 (no .NET install needed on the PCR machine).
       Only applies when a runtime is given, i.e. tools\publish.ps1 / dotnet publish -r win-x64,
       so normal builds keep writing to bin\Debug\net10.0-windows. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\templates\*.html" LinkBase="templates" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
