<Window x:Class="PcrGraphics.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="PCR Graphics" Height="820" Width="1280" MinWidth="1100" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#111316" Foreground="#E6E8EB" FontFamily="Segoe UI" FontSize="15"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewMouseDown="Window_PreviewMouseDown" Loaded="Window_Loaded" Closing="Window_Closing">

    <!-- Hotkeys act on the selected graphic. Space for TAKE is handled in code, only when not typing. -->
    <Window.InputBindings>
        <KeyBinding Key="F1" Command="{Binding SelectedSlot.CueCommand}" />
        <KeyBinding Key="F5" Command="{Binding NextCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveRundownCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenRundownCommand}" />
        <KeyBinding Key="F2" Command="{Binding SelectedSlot.TakeInCommand}" />
        <KeyBinding Key="F3" Command="{Binding SelectedSlot.TakeOutCommand}" />
        <KeyBinding Key="F4" Command="{Binding SelectedSlot.UpdateCommand}" />
        <KeyBinding Key="F12" Command="{Binding PanicCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Control buttons never take keyboard focus, so Space/Enter can never "click" one by accident. -->
        <Style x:Key="ControlButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#2A2F37" />
            <Setter Property="BorderBrush" Value="#3B424D" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="68" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#E6E8EB" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.28" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CueButton" TargetType="Button" BasedOn="{StaticResource ControlButton}">
            <Setter Property="Background" Value="#1F5130" />
        </Style>
        <Style x:Key="TakeButton" TargetType="Button" BasedOn="{StaticResource ControlButton}">
            <Setter Property="Background" Value="#7A1F1F" />
        </Style>
        <Style x:Key="PanicButton" TargetType="Button" BasedOn="{StaticResource ControlButton}">
            <Setter Property="Background" Value="#D32F2F" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Height" Value="52" />
            <Setter Property="Width" Value="220" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource ControlButton}">
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>

        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1A1D22" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="CaretBrush" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#3B424D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FlowDirection" Value="RightToLeft" />
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8B93A1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Small tally dot used in the graphics list -->
        <Style x:Key="TallyDot" TargetType="Ellipse">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Fill" Value="#3B424D" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding TallyPreview}" Value="True">
                    <Setter Property="Fill" Value="#2E7D32" />
                </DataTrigger>
                <DataTrigger Binding="{Binding TallyProgram}" Value="True">
                    <Setter Property="Fill" Value="#E53935" />
                </DataTrigger>
                <DataTrigger Binding="{Binding TallyUnknown}" Value="True">
                    <Setter Property="Fill" Value="#E08A00" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Graphics list items -->
        <Style x:Key="SlotItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Foreground" Value="#E6E8EB" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="#1E2228" BorderBrush="#2A2F37" BorderThickness="1"
                                CornerRadius="6" Padding="12,10">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26303D" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#5B8DEF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Focusable="True" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="130" />
        </Grid.RowDefinitions>

        <!-- Top bar: connection + panic -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14" LastChildFill="False">
            <Ellipse Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,10,0">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Setter Property="Fill" Value="#C62828" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                <Setter Property="Fill" Value="#2E7D32" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>
            <TextBlock Text="{Binding ConnectionText}" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" Style="{StaticResource PanicButton}"
                    Command="{Binding PanicCommand}" Content="PANIC ALL  ·  F12" />
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="290" />
            </Grid.ColumnDefinitions>

            <!-- Left column: graphics (slots) on top, rundown below -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="GRAPHICS  ·  ↑ ↓" Style="{StaticResource Caption}" Margin="0,0,0,10" />
                <ListBox Grid.Row="1" Margin="0,0,0,14" ItemsSource="{Binding Slots}" SelectedItem="{Binding SelectedSlot}"
                         ItemContainerStyle="{StaticResource SlotItem}"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <Ellipse DockPanel.Dock="Right" Style="{StaticResource TallyDot}" VerticalAlignment="Center" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16" />
                                    <TextBlock Text="{Binding StateText}" Foreground="#8B93A1" FontSize="12" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Rundown: graphics prepared before the show, in running order -->
                <DockPanel Grid.Row="2">
                    <TextBlock DockPanel.Dock="Top" Text="RUNDOWN  ·  F5 next  ·  Enter load" Style="{StaticResource Caption}" />
                    <TextBlock DockPanel.Dock="Top" Text="{Binding RundownTitle}" Foreground="#6F7784" FontSize="12" Margin="0,2,0,8" />
                    <ListBox ItemsSource="{Binding Rundown}" SelectedItem="{Binding SelectedItem}"
                             ItemContainerStyle="{StaticResource SlotItem}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding LoadItemCommand}" />
                            <MouseBinding Gesture="LeftDoubleClick" Command="{Binding LoadItemCommand}" />
                        </ListBox.InputBindings>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <Ellipse DockPanel.Dock="Right" Style="{StaticResource TallyDot}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding SlotTitle}" Foreground="#6F7784" FontSize="10" FontWeight="SemiBold" />
                                            <Border Background="#F0B429" CornerRadius="3" Padding="5,0" Margin="8,0,0,0"
                                                    Visibility="{Binding IsNext, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="NEXT  F5" Foreground="#111316" FontSize="10" FontWeight="Bold" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Line1}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Line2}" Foreground="#8B93A1" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <StackPanel Grid.Row="3" Margin="0,8,0,0">
                    <UniformGrid Columns="5" Margin="0,0,-6,0">
                        <Button Style="{StaticResource SmallButton}" Command="{Binding AddToRundownCommand}" Content="+ ADD" ToolTip="Add the editor text to the rundown" />
                        <Button Style="{StaticResource SmallButton}" Command="{Binding LoadItemCommand}" Content="LOAD" ToolTip="Load the selected item into the editor (Enter)" />
                        <Button Style="{StaticResource SmallButton}" Command="{Binding MoveUpCommand}" Content="▲" ToolTip="Move up" />
                        <Button Style="{StaticResource SmallButton}" Command="{Binding MoveDownCommand}" Content="▼" ToolTip="Move down" />
                        <Button Style="{StaticResource SmallButton}" Command="{Binding RemoveItemCommand}" Content="✕" ToolTip="Remove" />
                    </UniformGrid>
                    <UniformGrid Columns="3" Margin="0,0,-6,0">
                        <Button Style="{StaticResource SmallButton}" Command="{Binding NewRundownCommand}" Content="NEW" />
                        <Button Style="{StaticResource SmallButton}" Command="{Binding OpenRundownCommand}" Content="OPEN  ·  Ctrl+O" />
                        <Button Style="{StaticResource SmallButton}" Command="{Binding SaveRundownCommand}" Content="SAVE  ·  Ctrl+S" />
                    </UniformGrid>
                </StackPanel>
            </Grid>


            <!-- Editor + preview for the selected graphic -->
            <Border Grid.Column="2" Background="#181B20" CornerRadius="8" Padding="18">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" Margin="0,0,0,10">
                        <Run Text="{Binding SelectedSlot.Title, Mode=OneWay}" />
                        <Run Text="  ·  " />
                        <Run Text="{Binding SelectedSlot.LayerText, Mode=OneWay}" />
                    </TextBlock>

                    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding SelectedSlot.Fields}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,10">
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" />
                                        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Text="{Binding Counter}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TooLong}" Value="True">
                                                            <Setter Property="Foreground" Value="#FF6B6B" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DockPanel>
                                    <TextBox Style="{StaticResource FieldBox}"
                                             Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock DockPanel.Dock="Top" Foreground="#F0B429" FontSize="13" Margin="0,0,0,8"
                               Text="Text differs from the cued / on-air graphic: press UPDATE (F4) to send it."
                               Visibility="{Binding SelectedSlot.HasPendingEdit, Converter={StaticResource BoolToVis}}" />

                    <UniformGrid DockPanel.Dock="Bottom" Columns="4" Margin="0,10,-10,0">
                        <Button Style="{StaticResource CueButton}" Command="{Binding SelectedSlot.CueCommand}">
                            <TextBlock TextAlignment="Center">CUE<LineBreak /><Run FontSize="12" Text="F1" /></TextBlock>
                        </Button>
                        <Button Style="{StaticResource TakeButton}" Command="{Binding SelectedSlot.TakeInCommand}">
                            <TextBlock TextAlignment="Center">TAKE IN<LineBreak /><Run FontSize="12" Text="F2 / Space" /></TextBlock>
                        </Button>
                        <Button Style="{StaticResource ControlButton}" Command="{Binding SelectedSlot.TakeOutCommand}">
                            <TextBlock TextAlignment="Center">TAKE OUT<LineBreak /><Run FontSize="12" Text="F3" /></TextBlock>
                        </Button>
                        <Button Style="{StaticResource ControlButton}" Command="{Binding SelectedSlot.UpdateCommand}">
                            <TextBlock TextAlignment="Center">UPDATE<LineBreak /><Run FontSize="12" Text="F4" /></TextBlock>
                        </Button>
                    </UniformGrid>

                    <!-- Preview: the real template rendered by WebView2 (Chromium), like CasparCG does -->
                    <Grid x:Name="PreviewHost" Margin="0,6,0,0" SizeChanged="PreviewHost_SizeChanged">
                    <Border x:Name="PreviewFrame" Background="#30343B" BorderBrush="#3B424D" BorderThickness="1"
                            HorizontalAlignment="Center" VerticalAlignment="Top">
                        <Grid>
                            <wv2:WebView2 x:Name="Preview" />
                            <TextBlock x:Name="PreviewError" Visibility="Collapsed" TextWrapping="Wrap"
                                       Foreground="#F0B429" Margin="16" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Tally for the selected graphic -->
            <Border Grid.Column="4" Background="#181B20" CornerRadius="8" Padding="18">
                <StackPanel>
                    <TextBlock Text="TALLY" Style="{StaticResource Caption}" Margin="0,0,0,12" />
                    <UniformGrid Columns="2" Margin="0,0,0,16">
                        <Border Height="70" CornerRadius="6" Margin="0,0,6,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#262A31" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedSlot.TallyPreview}" Value="True">
                                            <Setter Property="Background" Value="#2E7D32" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedSlot.TallyUnknown}" Value="True">
                                            <Setter Property="Background" Value="#E08A00" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="PVW" FontSize="22" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border Height="70" CornerRadius="6" Margin="6,0,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#262A31" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedSlot.TallyProgram}" Value="True">
                                            <Setter Property="Background" Value="#C62828" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedSlot.TallyUnknown}" Value="True">
                                            <Setter Property="Background" Value="#E08A00" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="PGM" FontSize="22" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </UniformGrid>

                    <TextBlock Text="STATE" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding SelectedSlot.StateText}" FontSize="26" FontWeight="Bold" Margin="0,2,0,14" />

                    <TextBlock Text="ON THE LAYER" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding SelectedSlot.CurrentText}" FontSize="16" TextWrapping="Wrap"
                               FlowDirection="RightToLeft" Margin="0,4,0,14" />

                    <TextBlock TextWrapping="Wrap" Foreground="#F0B429" FontSize="13"
                               Visibility="{Binding SelectedSlot.TallyUnknown, Converter={StaticResource BoolToVis}}"
                               Text="Lost contact while this graphic was loaded. What is on air is unknown: press PANIC (F12) once CasparCG is connected." />
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding Message}" Margin="2,12,0,8" Foreground="#C9CED6" />

        <!-- AMCP log, newest first -->
        <ListBox Grid.Row="3" ItemsSource="{Binding Log}" Background="#0C0E10" Foreground="#9FD1A7"
                 BorderBrush="#2A2F37" FontFamily="Consolas" FontSize="12" Focusable="False" />
    </Grid>
</Window>
