<Window x:Class="PcrGraphics.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PCR Graphics" Height="700" Width="1140" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#111316" Foreground="#E6E8EB" FontFamily="Segoe UI" FontSize="15"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">

    <!-- Hotkeys. Space for TAKE is handled in MainWindow.xaml.cs, only when not typing. -->
    <Window.InputBindings>
        <KeyBinding Key="F1" Command="{Binding CueCommand}" />
        <KeyBinding Key="F2" Command="{Binding TakeInCommand}" />
        <KeyBinding Key="F3" Command="{Binding TakeOutCommand}" />
        <KeyBinding Key="F4" Command="{Binding UpdateCommand}" />
        <KeyBinding Key="F12" Command="{Binding PanicCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Control buttons never take keyboard focus, so Space/Enter can never "click" one by accident. -->
        <Style x:Key="ControlButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#2A2F37" />
            <Setter Property="BorderBrush" Value="#3B424D" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="74" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#E6E8EB" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.28" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CueButton" TargetType="Button" BasedOn="{StaticResource ControlButton}">
            <Setter Property="Background" Value="#1F5130" />
        </Style>
        <Style x:Key="TakeButton" TargetType="Button" BasedOn="{StaticResource ControlButton}">
            <Setter Property="Background" Value="#7A1F1F" />
        </Style>
        <Style x:Key="PanicButton" TargetType="Button" BasedOn="{StaticResource ControlButton}">
            <Setter Property="Background" Value="#D32F2F" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Height" Value="52" />
            <Setter Property="Width" Value="220" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1A1D22" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="CaretBrush" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#3B424D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FlowDirection" Value="RightToLeft" />
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8B93A1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Focusable="True" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="170" />
        </Grid.RowDefinitions>

        <!-- Top bar: connection + panic -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16" LastChildFill="False">
            <Ellipse Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,10,0">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Setter Property="Fill" Value="#C62828" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                <Setter Property="Fill" Value="#2E7D32" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>
            <TextBlock Text="{Binding ConnectionText}" VerticalAlignment="Center" FontSize="15" />
            <Button DockPanel.Dock="Right" Style="{StaticResource PanicButton}"
                    Command="{Binding PanicCommand}" Content="PANIC  ·  F12" />
        </DockPanel>

        <!-- Main area: editor on the left, tally on the right -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#181B20" CornerRadius="8" Padding="20">
                <StackPanel>
                    <TextBlock Text="LOWER THIRD  ·  layer 1-30" Style="{StaticResource Caption}" Margin="0,0,0,14" />

                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="Name  /  الاسم" Style="{StaticResource Caption}" />
                        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Text="{Binding NameCounter}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NameTooLong}" Value="True">
                                            <Setter Property="Foreground" Value="#FF6B6B" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DockPanel>
                    <TextBox Style="{StaticResource FieldBox}"
                             Text="{Binding GuestName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />

                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="Title  /  الصفة" Style="{StaticResource Caption}" />
                        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Text="{Binding TitleCounter}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TitleTooLong}" Value="True">
                                            <Setter Property="Foreground" Value="#FF6B6B" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DockPanel>
                    <TextBox Style="{StaticResource FieldBox}"
                             Text="{Binding GuestTitle, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                    <TextBlock Text="Text differs from the cued / on-air graphic: press UPDATE (F4) to send it."
                               Foreground="#F0B429" FontSize="13" Margin="0,0,0,14"
                               Visibility="{Binding HasPendingEdit, Converter={StaticResource BoolToVis}}" />

                    <UniformGrid Columns="4" Margin="0,8,-10,0">
                        <Button Style="{StaticResource CueButton}" Command="{Binding CueCommand}">
                            <TextBlock TextAlignment="Center">CUE<LineBreak /><Run FontSize="12" Text="F1" /></TextBlock>
                        </Button>
                        <Button Style="{StaticResource TakeButton}" Command="{Binding TakeInCommand}">
                            <TextBlock TextAlignment="Center">TAKE IN<LineBreak /><Run FontSize="12" Text="F2 / Space" /></TextBlock>
                        </Button>
                        <Button Style="{StaticResource ControlButton}" Command="{Binding TakeOutCommand}">
                            <TextBlock TextAlignment="Center">TAKE OUT<LineBreak /><Run FontSize="12" Text="F3" /></TextBlock>
                        </Button>
                        <Button Style="{StaticResource ControlButton}" Command="{Binding UpdateCommand}">
                            <TextBlock TextAlignment="Center">UPDATE<LineBreak /><Run FontSize="12" Text="F4" /></TextBlock>
                        </Button>
                    </UniformGrid>

                    <TextBlock Text="Esc: leave the text field so Space works as TAKE IN"
                               Style="{StaticResource Caption}" FontWeight="Normal" Margin="0,14,0,0" />
                </StackPanel>
            </Border>

            <!-- Tally -->
            <Border Grid.Column="2" Background="#181B20" CornerRadius="8" Padding="20">
                <StackPanel>
                    <TextBlock Text="TALLY" Style="{StaticResource Caption}" Margin="0,0,0,14" />
                    <UniformGrid Columns="2" Margin="0,0,0,18">
                        <Border Height="74" CornerRadius="6" Margin="0,0,6,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#262A31" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TallyPreview}" Value="True">
                                            <Setter Property="Background" Value="#2E7D32" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding TallyUnknown}" Value="True">
                                            <Setter Property="Background" Value="#E08A00" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="PVW" FontSize="22" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border Height="74" CornerRadius="6" Margin="6,0,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#262A31" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TallyProgram}" Value="True">
                                            <Setter Property="Background" Value="#C62828" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding TallyUnknown}" Value="True">
                                            <Setter Property="Background" Value="#E08A00" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="PGM" FontSize="22" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </UniformGrid>

                    <TextBlock Text="STATE" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding StateText}" FontSize="28" FontWeight="Bold" Margin="0,2,0,16" />

                    <TextBlock Text="ON THE LAYER" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding CurrentText}" FontSize="17" TextWrapping="Wrap"
                               FlowDirection="RightToLeft" Margin="0,4,0,16" />

                    <TextBlock TextWrapping="Wrap" Foreground="#F0B429" FontSize="13"
                               Visibility="{Binding TallyUnknown, Converter={StaticResource BoolToVis}}"
                               Text="Lost contact while a graphic was loaded. What is on air is unknown: press PANIC (F12) once CasparCG is connected." />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Last result -->
        <TextBlock Grid.Row="2" Text="{Binding Message}" Margin="2,14,0,8" FontSize="15" Foreground="#C9CED6" />

        <!-- AMCP log, newest first -->
        <ListBox Grid.Row="3" ItemsSource="{Binding Log}" Background="#0C0E10" Foreground="#9FD1A7"
                 BorderBrush="#2A2F37" FontFamily="Consolas" FontSize="12" Focusable="False" />
    </Grid>
</Window>
